{
  "name": "llm-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard-first PDF reader with a built-in LLM tutor. See DESIGN.md.",
  "repository": {
    "type": "git",
    "url": "https://github.com/czhou578/llm-reader.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"vite\" \"tsx watch src/server/main.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "vite build",
    "start": "pnpm build && tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "llm-reader": "tsx bin/llm-reader.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@preact/signals": "^2.11.4",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "eventsource-parser": "^4.1.3",
    "hono": "^4.13.16",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "6.4.299",
    "preact": "^11.1.1",
    "smol-toml": "^1.9.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
